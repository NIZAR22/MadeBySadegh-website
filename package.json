{
  "name": "nizar-starter-site",
  "version": "1.0.0",
  "description": "Reusable starter site for local service businesses (Vue 2 + Vuetify), driven by site-config.js",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint --no-fix",
    "lint:fix": "vue-cli-service lint",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-site.ps1",
    "check:template": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-site.ps1 -AllowMarkers"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "vue": "^2.7.16",
    "vue-recaptcha": "^2.0.3",
    "vuetify": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-standard": "^6.1.0",
    "@vue/test-utils": "^1.3.5",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^26.6.3",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^7.20.0",
    "jest": "^26.6.3",
    "sass": "~1.32.13",
    "sass-loader": "^12.0.0",
    "vue-cli-plugin-vuetify": "~2.5.0",
    "vue-jest": "^4.0.1",
    "vue-template-compiler": "^2.7.16",
    "vuetify-loader": "^1.9.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
